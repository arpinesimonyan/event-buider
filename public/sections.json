[
  {
    "key": "transport", "name": "Transport", "sub": "Getting people there and back",
    "fields": [
      {"id":"mode", "label":"Mode of transport", "type":"select", "options":["Bus","Car / Shuttle","Train","Flight","Walking","Other"]},
      {"id":"pickup", "label":"Pickup point", "type":"text"},
      {"id":"dropoff", "label":"Drop-off point", "type":"text"},
      {"id":"headcount", "label":"Travelers / vehicles", "type":"text"},
      {"id":"departure", "label":"Departure time", "type":"time"},
      {"id":"contact", "label":"Driver / dispatcher contact", "type":"text"},
      {"id":"notes", "label":"Notes", "type":"textarea", "full":true}
    ]
  },
  {
    "key": "translations", "name": "Translations", "sub": "Languages and interpretation",
    "fields": [
      {"id":"languages", "label":"Languages required", "type":"text", "placeholder":"e.g. EN, HY, RU"},
      {"id":"interpreters", "label":"Number of interpreters", "type":"text"},
      {"id":"interpType", "label":"Interpretation type", "type":"select", "options":["Simultaneous","Consecutive","Whisper (chuchotage)","Written only"]},
      {"id":"equipment", "label":"Equipment needed", "type":"text", "placeholder":"e.g. headsets, booth"},
      {"id":"sessionTimes", "label":"Session times", "type":"text"},
      {"id":"notes", "label":"Notes", "type":"textarea", "full":true}
    ]
  },
  {
    "key": "venue", "name": "Venue", "sub": "Where it happens",
    "fields": [
      {"id":"name", "label":"Venue name", "type":"text"},
      {"id":"address", "label":"Address", "type":"text"},
      {"id":"capacity", "label":"Capacity", "type":"text"},
      {"id":"layout", "label":"Room layout", "type":"select", "options":["Theatre","Classroom","Banquet","U-shape","Boardroom","Reception / standing"]},
      {"id":"av", "label":"AV requirements", "type":"text", "placeholder":"e.g. mic, projector, livestream"},
      {"id":"accessibility", "label":"Accessibility notes", "type":"text"},
      {"id":"notes", "label":"Notes", "type":"textarea", "full":true}
    ]
  },
  {
    "key": "meal", "name": "Meal", "sub": "Food and beverage",
    "fields": [
      {"id":"type", "label":"Meal type", "type":"select", "options":["Breakfast","Lunch","Dinner","Coffee break","Reception / cocktail"]},
      {"id":"headcount", "label":"Headcount", "type":"text"},
      {"id":"dietary", "label":"Dietary restrictions", "type":"text", "placeholder":"e.g. vegan, halal, nut-free"},
