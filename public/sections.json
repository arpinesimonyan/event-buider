      {"id":"notes", "label":"Notes", "type":"textarea", "full":true}
    ]
  },
  {
    "key": "logistics", "name": "Logistics", "sub": "Everything holding it together",
    "fields": [
      {"id":"schedule", "label":"Run of show", "type":"textarea", "full":true, "placeholder":"Key timings, in order"},
      {"id":"staffing", "label":"Staffing / roles", "type":"text"},
      {"id":"signage", "label":"Signage needs", "type":"text"},
      {"id":"contingency", "label":"Contingency plan", "type":"textarea", "full":true},
      {"id":"contact", "label":"Primary on-site contact", "type":"text"}
